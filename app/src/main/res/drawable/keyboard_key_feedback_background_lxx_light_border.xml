<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid
        android:color="#F6F8FA" />
    <!-- the width is the popup's minimum width AND KeyPreviewView's room for the letter (minus the side padding):
         wide enough that a single letter isn't squeezed, flatter on top (the font padding is off in KeyPreviewView) -->
    <size
        android:height="5dp"
        android:width="52dp"/>
    <padding android:left="8dp"
        android:top="3dp"
        android:right="8dp"
        android:bottom="60dp" />
    <corners android:radius="5dp" />
</shape>